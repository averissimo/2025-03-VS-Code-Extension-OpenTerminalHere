{
  "name": "open-rterminal-here",
  "displayName": "Open R Terminal Here",
  "description": "Open R terminal at the selected folder location or current file directory",
  "version": "1.0.1",
  "publisher": "averissimo",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/averissimo/open-terminal-here.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "open-rterminal-here.openRTerminalHere",
        "title": "Open R terminal Here"
      },
      {
        "command": "open-rterminal-here.insertDevtoolsDocumentToTerminal",
        "title": "run devtools::document"
      },
      {
        "command": "open-rterminal-here.insertLoadAllTerminal",
        "title": "run pkgload::load_all"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "open-rterminal-here.openRTerminalHere",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+shift+t",
        "command": "workbench.action.terminal.newWithCwd",
        "args": {
          "cwd": "${fileDirname}"
        }
      }
    ]
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "package": "vsce package"
  },
  "keywords": [
    "terminal",
    "folder",
    "context menu"
  ],
  "author": "André Veríssimo",
  "license": "MIT",
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.24.0"
  }
}
